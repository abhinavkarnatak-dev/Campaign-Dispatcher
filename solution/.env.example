# Copy this file to solution/.env only if you want to change the defaults.
# With no .env at all, everything runs locally against `temporal server start-dev`.

# Temporal Cloud (leave empty to use the local dev server)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Optional overrides (defaults shown)
# PROVIDER_URL=http://127.0.0.1:8099
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8200
# TASK_QUEUE=campaign-dispatcher
